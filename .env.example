# Copia questo file in .env.local (ignorato da git) e inserisci i tuoi valori.
# Li trovi in Supabase: Project Settings → API.
# Sono valori PUBBLICI (protetti dalla Row Level Security), non segreti da nascondere,
# ma vanno comunque impostati per ambiente (dev/produzione) invece che nel codice.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
